# ==============================================================================
# FlowForge Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure real credentials for your environment.
# DO NOT commit .env with real secrets to version control.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=flowforge
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=your_secure_db_password_here

# Spring Boot Backend Database Credentials
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/flowforge
SPRING_DATASOURCE_USERNAME=flowforge
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# JWT Authentication Secret
# Must be at least 256 bits (32 bytes). Can be Base64-encoded or plain text.
APP_JWT_SECRET=your_base64_or_256bit_secret_key_here
APP_JWT_EXPIRATION_MILLISECONDS=86400000

# RabbitMQ Message Broker Credentials
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Redis Cache
REDIS_URL=redis://redis:6379/0

# Python Worker Service Database Connection
DATABASE_URL=postgresql://flowforge:your_secure_db_password_here@db:5432/flowforge

# Frontend Configuration
VITE_API_URL=http://localhost:8080
